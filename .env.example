# Database Settings
MONGO_URI=mongodb://localhost:27017
DB_NAME=secops_db

MAX_CONCURRENT_SERVERS=20

# Security
SECRET_KEY=change_this_to_a_random_string

ELASTICSEARCH_URL=http://localhost:9200


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=password
ALERT_FROM_EMAIL=your_email@gmail.com
ALERT_RECIPIENTS=your_email@gmail.com


LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4-6

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

OPENROUTER_API_KEY=sk-or-v1-your-key-here



# Optional — customize what shows in OpenRouter analytics dashboard
#OPENROUTER_SITE_URL=https://secops-platform
#OPENROUTER_SITE_NAME=SecOps

# Only required if switching to LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Only required if switching to LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Only used if you revive the parked Ollama path (LLM_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434